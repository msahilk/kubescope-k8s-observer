# Copy to .env (gitignored); scripts/dev.sh loads it. No secrets belong here:
# KubeScope uses your kubeconfig for credentials.

# kubeconfig context to use. KubeScope never silently falls back to another context.
KUBESCOPE_CONTEXT=kind-kubescope
# For GKE, use the exact name from `kubectl config current-context`, e.g.
# KUBESCOPE_CONTEXT=gke_YOUR_PROJECT_ID_us-central1-a_kubescope-lab

# Optional explicit kubeconfig path (default: $KUBECONFIG or ~/.kube/config)
# KUBECONFIG=/path/to/kubeconfig

KUBESCOPE_NAMESPACE=kubescope-demo
KUBESCOPE_ALLOWED_NAMESPACES=kubescope-demo
KUBESCOPE_DEPLOYMENT=demo-api

KUBESCOPE_MIN_REPLICAS=1
KUBESCOPE_MAX_REPLICAS=5          # hard limit 10
KUBESCOPE_BASELINE_REPLICAS=2
KUBESCOPE_EXPERIMENT_TIMEOUT=120s
KUBESCOPE_MUTATIONS_PER_MINUTE=20

# Localhost only. Do not expose the unauthenticated API.
KUBESCOPE_ADDR=127.0.0.1:8080
# KUBESCOPE_ALLOW_NON_LOOPBACK=false
# KUBESCOPE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# KUBESCOPE_STATIC_DIR=../frontend/dist
